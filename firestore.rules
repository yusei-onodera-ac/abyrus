// ABYRUS の Firestore ルール: 無限モードのランキング + 同盟（アライアンス） + データ引き継ぎ + 管理画面 (abyrus-admin) の管理者・ショップ・プレミアム。
// Firebase プロジェクト abyrus-game は、ゲームと管理画面で共用。ルールは1プロジェクトに1つだけ公開できるので、両方の分を、このファイルに入れてある。
// 公開する前に、必ず admins/{自分の認証uid} を、Firebase コンソールで作っておくこと (作る前に公開すると、管理画面に入れなくなる)。
// 同盟の設計と、各ルールが何を守るかは、docs/ALLIANCE_SERVER.md に書いてある。
// ※ 未検証。Firebase プロジェクトにつないで、エミュレーターか本番で、試してから公開すること。
//
// 考え方:
//   - プレイヤーの手元の持ち物（ゴールド・素材・魔晶石）は、端末のセーブにあり、サーバーは検証できない。
//     だから、ここで守るのは「他のプレイヤーと、みんなの共有の状態」。1人が1日に与えられる影響に、上限を置く。
//   - ボスへのダメージと、切符 (tickets) は、Cloud Functions (Admin SDK = ルールの外) だけが書く。クライアントは書けない。
//   - 1日の回数は、`members/{自分}/daily/{その日}` の1つのドキュメントで数える。ドキュメントIDが「今日」でなければ書けない。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================== 共通の道具

    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function userPath(u) {
      return /databases/$(database)/documents/users/$(u);
    }
    function alliancePath(a) {
      return /databases/$(database)/documents/alliances/$(a);
    }
    function memberPath(a, u) {
      return /databases/$(database)/documents/alliances/$(a)/members/$(u);
    }
    function isMember(a) {
      return signedIn() && exists(memberPath(a, uid()));
    }
    function roleOf(a) {
      return get(memberPath(a, uid())).data.role;
    }
    function isLeader(a) {
      return isMember(a) && roleOf(a) == 'leader';
    }
    function isOfficerUp(a) {
      return isMember(a) && (roleOf(a) == 'leader' || roleOf(a) == 'officer');
    }
    // 4:00 (日本時間) 区切りの日付。UTC に 5 時間足した暦の年月日 (桁はそろえない)。
    // src/game/alliance/onlineLogic.ts の dayKey() と同じ形。
    function dayKey() {
      let t = request.time + duration.value(5, 'h');
      return string(t.year()) + '-' + string(t.month()) + '-' + string(t.day());
    }
    // 月曜 0:00 (日本時間) 区切りの週。その週の月曜の日付 (桁はそろえない)。src/game/alliance/onlineLogic.ts の mondayKey() と同じ形。
    function weekKey() {
      let t = request.time + duration.value(9, 'h');
      let monday = t - duration.value(t.dayOfWeek() - 1, 'd');
      return string(monday.year()) + '-' + string(monday.month()) + '-' + string(monday.day());
    }
    function dailyPath(a, u) {
      return /databases/$(database)/documents/alliances/$(a)/members/$(u)/daily/$(dayKey());
    }
    function memberMaxFor(level) {
      return level >= 10 ? 30 : (level >= 5 ? 25 : 20);
    }

    // ====================================================================== 無限モードのランキング（BACKEND_SETUP.md のとおり。変えない）

    match /infiniteModeScores/{entryId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == entryId
        && isValidEntry(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == entryId
        && isValidEntry(request.resource.data)
        && request.resource.data.score >= resource.data.score;

      allow delete: if false;
    }

    function isValidEntry(data) {
      return data.score is number
        && data.score >= 0
        && data.score <= 100000000
        && data.survivalSeconds is number
        && data.survivalSeconds >= 0
        && data.survivalSeconds <= 86400
        && data.enemiesDefeated is number
        && data.enemiesDefeated >= 0
        && data.enemiesDefeated <= 1000000
        && data.difficultyReached is number
        && data.difficultyReached >= 0
        && data.playerName is string
        && data.playerName.size() <= 24
        && data.updatedAt == request.time;
    }

    // ====================================================================== 管理画面 (abyrus-admin) と、ショップ・プレミアムの価格
    // 管理画面 (別のリポジトリ abyrus-admin) と、同じ Firebase プロジェクトを使っているので、ルールは1つのファイルにまとめる。
    // ここから下の「管理画面」の節は、abyrus-admin の firestore.rules (コミット 36bd365) から、そのまま写したもの。
    // 管理者は、Firebase コンソールで admins/{認証uid} のドキュメントを手で作った人だけ (メールアドレスはどこにも書かない)。
    // shopProducts と config/premium は、ゲームが読む (サインイン不要)。書けるのは管理者だけで、中身は RemoteShopConfig.ts と同じ検査を通す。

    // --- Admin allow-list ---
    // An admin is an Authentication user whose uid has a matching document
    // here. The document's content is never read by any rule below (only
    // its existence matters), and this collection itself is never readable
    // or writable from a client - the project owner adds/removes an
    // admins/{uid} document by hand from the Firebase console (see
    // SETUP.md). No email address appears in these rules or in app code.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminUid} {
      allow read, write: if false;
    }

    // --- shopProducts / config/premium schema (mirrors
    // src/game/systems/RemoteShopConfig.ts in the game repo field-for-field
    // and limit-for-limit - keep the two in sync on any schema change).
    // A write that does not match this shape is rejected here, so nothing
    // the game would silently drop can ever be saved as if it worked. ----

    function isGoodType(t) {
      return t in ['gems', 'gold', 'stamina', 'phaseMaterials', 'skillEssence',
                   'exp_s', 'exp_m', 'exp_l', 'exp_xl', 'equip_essence'];
    }

    function isValidGood(g) {
      return g is map
        && g.keys().hasOnly(['type', 'amount'])
        && g.type is string && isGoodType(g.type)
        && g.amount is int && g.amount >= 1 && g.amount <= 1000000000;
    }

    // Firestore rules have no array loop, so each index up to the 10-item
    // cap is checked by hand; an index past the list's actual size is
    // trivially fine (there's nothing there to check).
    function isValidGoodAt(goods, i) {
      return goods.size() <= i || isValidGood(goods[i]);
    }

    function isValidGoodsList(goods) {
      return goods is list && goods.size() >= 1 && goods.size() <= 10
        && isValidGoodAt(goods, 0) && isValidGoodAt(goods, 1) && isValidGoodAt(goods, 2)
        && isValidGoodAt(goods, 3) && isValidGoodAt(goods, 4) && isValidGoodAt(goods, 5)
        && isValidGoodAt(goods, 6) && isValidGoodAt(goods, 7) && isValidGoodAt(goods, 8)
        && isValidGoodAt(goods, 9);
    }

    // The document's id is the purchase-count key on the game side
    // (SaveData.shop.purchases) - this rule only checks the document's
    // *content*, never its id; nothing here stops an id from being reused
    // or renamed, that is an operational rule for whoever edits the data.
    function isValidShopProduct(d) {
      return d.keys().hasOnly(['name', 'description', 'group', 'priceCurrency', 'priceAmount',
                                'goods', 'bonus', 'limitPeriod', 'limitCount', 'badge',
                                'startsAt', 'endsAt', 'category', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.group in ['pack', 'gems', 'gold', 'item']
        && d.priceCurrency in ['yen', 'gems', 'gold']
        && d.priceAmount is int && d.priceAmount >= 1
        && d.priceAmount <= (d.priceCurrency == 'yen' ? 1000000 : 1000000000)
        && isValidGoodsList(d.goods)
        && (!('description' in d) || d.description == null || d.description == ''
            || (d.description is string && d.description.size() <= 300))
        && (!('bonus' in d) || d.bonus == null
            || (d.bonus is int && d.bonus >= 0 && d.bonus <= 1000000000))
        // 'none' (the admin form's own "no limit" default) is rejected on
        // purpose, same as the game's parser: it must be left out / null,
        // never the literal string 'none'.
        && (!('limitPeriod' in d) || d.limitPeriod == null || d.limitPeriod == ''
            || (d.limitPeriod in ['once', 'day', 'week', 'month']
                && (!('limitCount' in d) || d.limitCount == null
                    || (d.limitCount is int && d.limitCount >= 1 && d.limitCount <= 9999))))
        && (!('badge' in d) || d.badge == null || d.badge == ''
            || (d.badge is string && d.badge.size() <= 16))
        && (!('startsAt' in d) || d.startsAt == null || d.startsAt == ''
            || d.startsAt is string || d.startsAt is timestamp)
        && (!('endsAt' in d) || d.endsAt == null || d.endsAt == ''
            || d.endsAt is string || d.endsAt is timestamp)
        && (!('category' in d) || d.category == null || d.category == ''
            || d.category in ['stamina', 'material']);
    }

    // One hasOnly() across the union of fields (instead of one per branch,
    // times up to 12 reward slots) keeps this well clear of the rules
    // engine's per-request expression-count ceiling.
    function isValidPremiumReward(r) {
      return r is map
        && r.keys().hasOnly(['type', 'amount', 'item', 'rarity'])
        && r.amount is int && r.amount >= 1 && r.amount <= 1000000000
        && (
          (r.type in ['gems', 'gold', 'stamina', 'phaseMaterials', 'skillEssence']
            && !('item' in r) && !('rarity' in r))
          || (r.type == 'item' && !('rarity' in r)
            && r.item in ['exp_s', 'exp_m', 'exp_l', 'exp_xl', 'equip_essence'])
          || (r.type == 'equipment' && !('item' in r)
            && r.rarity is int && r.rarity >= 1 && r.rarity <= 5)
        );
    }

    function isValidJoinPackAt(pack, i) {
      return pack.size() <= i || isValidPremiumReward(pack[i]);
    }

    function isValidJoinPack(pack) {
      return pack is list && pack.size() <= 12
        && isValidJoinPackAt(pack, 0) && isValidJoinPackAt(pack, 1) && isValidJoinPackAt(pack, 2)
        && isValidJoinPackAt(pack, 3) && isValidJoinPackAt(pack, 4) && isValidJoinPackAt(pack, 5)
        && isValidJoinPackAt(pack, 6) && isValidJoinPackAt(pack, 7) && isValidJoinPackAt(pack, 8)
        && isValidJoinPackAt(pack, 9) && isValidJoinPackAt(pack, 10) && isValidJoinPackAt(pack, 11);
    }

    function isValidPremiumConfig(d) {
      return d.keys().hasOnly(['yen', 'durationDays', 'dailyGems', 'battleSpeed', 'idleCapHours',
                                'joinPack', 'updatedAt'])
        && d.yen is int && d.yen >= 1 && d.yen <= 1000000
        && d.durationDays is int && d.durationDays >= 1 && d.durationDays <= 365
        && d.dailyGems is int && d.dailyGems >= 0 && d.dailyGems <= 100000
        && d.battleSpeed is number && d.battleSpeed >= 1 && d.battleSpeed <= 4
        && d.idleCapHours is int && d.idleCapHours >= 1 && d.idleCapHours <= 168
        && d.joinPack is list && isValidJoinPack(d.joinPack);
    }

    // --- This admin app's own collections: allow-listed admins only. ---
    // announcements: the game's お知らせ board reads the published ones (it asks for `active == true`, which is what lets a player
    // read them; a query without that filter is refused). Everything else is admin-only, as before.
    match /announcements/{docId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow write: if isAdmin();
    }
    // gifts / mail: the プレゼント and メール the operator sends to EVERYONE are read by the game (it asks for
    // `status == 'sent' && recipientType == 'all'`, which is what lets a player read them; a query without those filters is refused).
    // Drafts, and anything addressed to one named player, stay admin-only. Writes are admin-only.
    match /gifts/{docId} {
      allow read: if isAdmin() || (resource.data.status == 'sent' && resource.data.recipientType == 'all');
      allow write: if isAdmin();
    }
    match /mail/{docId} {
      allow read: if isAdmin() || (resource.data.status == 'sent' && resource.data.recipientType == 'all');
      allow write: if isAdmin();
    }
    match /inquiries/{docId} { allow read, write: if isAdmin(); }
    match /bugReports/{docId} { allow read, write: if isAdmin(); }
    match /gachaBanners/{docId} { allow read, write: if isAdmin(); }

    // Shop pricing: publicly readable (no sign-in) so the GAME client can
    // fetch it, same as infiniteModeScores above; writes are admin-only and
    // schema-checked (isValidShopProduct above).
    match /shopProducts/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidShopProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /events/{docId} { allow read, write: if isAdmin(); }
    match /homeBanners/{docId} { allow read, write: if isAdmin(); }
    // loginBonusDays/{day} { day: 1..31, reward, note? }: the reward of each day of the month; the document id IS the day ("1".."31") and
    // `day` must say the same, so the two can never drift apart. The game reads the whole table at launch (publicly, no sign-in);
    // writes are admin-only and checked (the reward is the game's Reward; a day's gems are capped at 100000 as a guard against a slip of
    // the finger). Design: abyrus-admin session, agreed with the game side.
    function isValidLoginBonusReward(r) {
      return r is map
        && r.keys().hasOnly(['type', 'amount', 'item', 'rarity'])
        && r.amount is int && r.amount >= 1
        && (
          (r.type == 'gems' && !('item' in r) && !('rarity' in r) && r.amount <= 100000)
          || (r.type in ['gold', 'stamina', 'phaseMaterials', 'skillEssence']
              && !('item' in r) && !('rarity' in r) && r.amount <= 1000000000)
          || (r.type == 'item' && !('rarity' in r)
              && r.item in ['exp_s', 'exp_m', 'exp_l', 'exp_xl', 'equip_essence']
              && r.amount <= 1000000000)
          || (r.type == 'equipment' && !('item' in r)
              && r.rarity is int && r.rarity >= 1 && r.rarity <= 5
              && r.amount <= 1000000000)
        );
    }
    function isValidLoginBonusDay(day, d) {
      return d.keys().hasOnly(['day', 'reward', 'note', 'updatedAt'])
        && d.day is int && d.day >= 1 && d.day <= 31 && string(d.day) == day
        && isValidLoginBonusReward(d.reward)
        && (!('note' in d) || d.note == null || d.note == '' || (d.note is string && d.note.size() <= 200));
    }
    match /loginBonusDays/{day} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidLoginBonusDay(day, request.resource.data);
      allow delete: if isAdmin();
    }
    match /heroDefinitions/{docId} { allow read, write: if isAdmin(); }
    match /equipmentDefinitions/{docId} { allow read, write: if isAdmin(); }
    match /missionDefs/{docId} { allow read, write: if isAdmin(); }
    match /limitedEvents/{docId} { allow read, write: if isAdmin(); }
    match /campaigns/{docId} { allow read, write: if isAdmin(); }
    match /questRegions/{docId} { allow read, write: if isAdmin(); }
    match /weekdayDungeons/{docId} { allow read, write: if isAdmin(); }
    match /expeditions/{docId} { allow read, write: if isAdmin(); }
    match /collectionMilestones/{docId} { allow read, write: if isAdmin(); }
    match /allianceShopItems/{docId} { allow read, write: if isAdmin(); }
    match /notes/{docId} { allow read, write: if isAdmin(); }

    // config/maintenance { enabled, message }: the game reads it at launch (publicly, no sign-in) to show the メンテナンス screen.
    // Writes are admin-only and checked (the admin form also sends `updatedAt`).
    function isValidMaintenance(d) {
      return d.keys().hasOnly(['enabled', 'message', 'updatedAt'])
        && d.enabled is bool
        && d.message is string && d.message.size() <= 300;
    }

    // config/*: admin-only, except config/premium and config/maintenance, which (like shopProducts)
    // are publicly readable and schema-checked on write. The docId guards
    // keep this wildcard block from ever being the one that decides
    // those documents' access (Firestore merges every matching block with
    // OR, so without the guard this block's un-checked isAdmin() write
    // would stand in for the stricter rule below on those documents).
    match /config/{docId} {
      allow read, write: if docId != 'premium' && docId != 'maintenance' && isAdmin();
    }
    match /config/maintenance {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMaintenance(request.resource.data);
      allow delete: if isAdmin();
    }
    match /config/premium {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPremiumConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    // ====================================================================== プレイヤー

    // users/{認証uid}: 自分のプロフィール。playerId (フレンドID) は、いちど決めたら変えられない。
    // leftAt (同盟を抜けた時刻) は、自分で「いまの時刻」にしかできない (消して、24時間の待ちを逃れることはできない)。
    function validUser(d) {
      return d.keys().hasOnly(['playerId', 'name', 'level', 'power', 'allianceId', 'leftAt', 'updatedAt'])
        && d.playerId is string && d.playerId.size() == 8
        && d.name is string && d.name.size() <= 24
        && d.level is number && d.level >= 1 && d.level <= 999
        && d.power is number && d.power >= 0
        && (d.allianceId == null || d.allianceId is string)
        && d.updatedAt == request.time;
    }

    match /users/{authUid} {
      allow read: if signedIn();

      allow create: if signedIn() && authUid == uid()
        && validUser(request.resource.data)
        && request.resource.data.allianceId == null
        && request.resource.data.leftAt == null;

      allow update: if signedIn() && authUid == uid()
        && validUser(request.resource.data)
        && request.resource.data.playerId == resource.data.playerId
        && (request.resource.data.leftAt == resource.data.leftAt || request.resource.data.leftAt == request.time)
        // allianceId は、null (抜けた・直した) か、いまのまま、か、同じバッチで自分のメンバー文書ができるときだけ。
        && (request.resource.data.allianceId == null
            || request.resource.data.allianceId == resource.data.allianceId
            || existsAfter(memberPath(request.resource.data.allianceId, uid())));

      allow delete: if false;

      // 自分あての招待 (users/{自分}/invites/{同盟ID})。幹部以上が書く。同じ人に同じ同盟から、1日に1回まで。
      match /invites/{inviteAlliance} {
        allow read: if signedIn() && authUid == uid();
        allow create: if signedIn() && isOfficerUp(inviteAlliance)
          && request.resource.data.keys().hasOnly(['allianceName', 'emblem', 'fromAuth', 'fromName', 'at'])
          && request.resource.data.fromAuth == uid()
          && request.resource.data.at == request.time;
        allow update: if signedIn() && isOfficerUp(inviteAlliance)
          && request.resource.data.keys().hasOnly(['allianceName', 'emblem', 'fromAuth', 'fromName', 'at'])
          && request.resource.data.fromAuth == uid()
          && request.resource.data.at == request.time
          && resource.data.at + duration.value(1, 'd') < request.time;
        allow delete: if signedIn() && authUid == uid();
      }

      // 自分が出した参加申請の控え (users/{自分}/requestsOut/{同盟ID})。
      match /requestsOut/{outAlliance} {
        allow read, create, delete: if signedIn() && authUid == uid();
        allow update: if false;
      }
    }

    // playerIndex/{フレンドID}: フレンドID -> 認証uid。いちど決めたら、変えられない (先着)。
    match /playerIndex/{playerId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authUid'])
        && request.resource.data.authUid == uid()
        && getAfter(userPath(uid())).data.playerId == playerId;
      allow update, delete: if false;
    }

    // ====================================================================== データ引き継ぎ

    // transfers/{引き継ぎコード}: パスワードで暗号化した、セーブ1つ。サーバーにあるのは暗号文だけで、パスワードは端末の外に出ない
    // (暗号化は、端末の中: src/game/systems/TransferCrypto.ts)。ドキュメントID = 引き継ぎコード (紛らわしい文字を除いた32文字から、
    // 乱数で20文字: 100ビット)。コードを知っている人が、1件だけ読める (一覧は、できない)。
    // 作れるのは、サインインした人 (匿名でよい) が、自分の uid を ownerUid にして、決まった形で作るときだけ。暗号文は 600,000 バイトまで
    // (base64 で 800,000 文字まで。Firestore のドキュメントの上限 1MiB より、ずっと小さい)。書きかえ・消すのは、持ち主だけ。
    // 回数・長さ・上限は、TransferCrypto.ts と同じ数字。変えるときは、両方を。
    function validTransfer(d) {
      return d.keys().hasOnly(['version', 'kdf', 'iterations', 'salt', 'iv', 'compression', 'ciphertext', 'size', 'ownerUid', 'savedAt'])
        && d.keys().hasAll(['version', 'kdf', 'iterations', 'salt', 'iv', 'compression', 'ciphertext', 'size', 'ownerUid', 'savedAt'])
        && d.version == 1
        && d.kdf == 'PBKDF2-SHA256'
        && d.iterations is int && d.iterations >= 100000 && d.iterations <= 2000000
        && d.salt is string && d.salt.size() == 24
        && d.iv is string && d.iv.size() == 16
        && d.compression in ['gzip', 'none']
        && d.size is int && d.size > 16 && d.size <= 600000
        && d.ciphertext is string && d.ciphertext.size() == math.ceil(d.size / 3.0) * 4
        && d.ownerUid is string
        && d.savedAt == request.time;
    }

    match /transfers/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('[A-HJ-NP-Z2-9]{20}')
        && request.resource.data.ownerUid == uid()
        && validTransfer(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerUid == uid()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validTransfer(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == uid();
    }

    // ====================================================================== 同盟

    // allianceNames/{名前を小文字にしたもの}: 名前の重複を防ぐ。同盟長が、同盟の作成・改名・解散と同じバッチで書く。
    match /allianceNames/{nameLower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['allianceId'])
        && request.resource.data.allianceId is string
        && getAfter(alliancePath(request.resource.data.allianceId)).data.nameLower == nameLower
        && getAfter(alliancePath(request.resource.data.allianceId)).data.leaderAuth == uid();
      allow delete: if signedIn() && get(alliancePath(resource.data.allianceId)).data.leaderAuth == uid();
      allow update: if false;
    }

    function validNewAlliance(d) {
      return d.keys().hasOnly(['name', 'nameLower', 'emblem', 'description', 'level', 'exp', 'memberCount', 'memberMax', 'joinPolicy', 'minPlayerLevel', 'leaderName', 'leaderAuth', 'weekPoints', 'power', 'league', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 10
        && d.nameLower is string && d.nameLower.size() >= 1 && d.nameLower.size() <= 40
        && d.emblem is int && d.emblem >= 0 && d.emblem < 12
        && d.description is string && d.description.size() <= 60
        && d.joinPolicy in ['open', 'approval', 'invite']
        && d.minPlayerLevel is int && d.minPlayerLevel >= 0 && d.minPlayerLevel <= 50
        && d.level == 1 && d.exp == 0 && d.memberCount == 1 && d.memberMax == 20 && d.weekPoints == 0
        && d.power is number && d.power >= 0
        && d.league == 'bronze'
        && d.leaderAuth == uid() && d.leaderName is string && d.leaderName.size() <= 24
        && d.createdAt == request.time && d.updatedAt == request.time;
    }

    // 同盟長が、設定を変える (名前・紋章・説明・参加方式・条件)、または、同盟長を譲る。
    function isLeaderSettingsUpdate(a) {
      let n = request.resource.data;
      let o = resource.data;
      return isLeader(a)
        && n.diff(o).affectedKeys().hasOnly(['name', 'nameLower', 'emblem', 'description', 'joinPolicy', 'minPlayerLevel', 'leaderName', 'leaderAuth', 'updatedAt'])
        && n.name.size() >= 2 && n.name.size() <= 10 && n.nameLower is string && n.nameLower.size() >= 1 && n.nameLower.size() <= 40
        && n.emblem is int && n.emblem >= 0 && n.emblem < 12
        && n.description.size() <= 60
        && n.joinPolicy in ['open', 'approval', 'invite']
        && n.minPlayerLevel is int && n.minPlayerLevel >= 0 && n.minPlayerLevel <= 50
        && (n.leaderAuth == o.leaderAuth || getAfter(memberPath(a, n.leaderAuth)).data.role == 'leader')
        && n.updatedAt == request.time;
    }

    // 人数が1人ふえる (自分が入る) / 1人へる (自分が抜ける、または、幹部以上が外す)。
    function isMemberCountUpdate(a) {
      let n = request.resource.data;
      let o = resource.data;
      return n.diff(o).affectedKeys().hasOnly(['memberCount', 'updatedAt'])
        && n.updatedAt == request.time
        && ((n.memberCount == o.memberCount + 1
              && n.memberCount <= o.memberMax
              && existsAfter(memberPath(a, uid()))
              && !exists(memberPath(a, uid())))
            || (n.memberCount == o.memberCount - 1
              && n.memberCount >= 1
              && ((exists(memberPath(a, uid())) && !existsAfter(memberPath(a, uid()))) || isOfficerUp(a))));
    }

    // 寄付: 同盟EXPと同盟Lv、今週のポイント、同盟の資金 (研究に使う。寄付1回で、同盟EXPと同じだけ増える: 最大300)。
    // 同じバッチで、自分の「今日の寄付」が1つ増えるときだけ。
    // Lvは1つずつしか上がらず、上がれるのは、EXPが足りる (あと300で届く) ときだけ。
    function isDonationUpdate(a) {
      let n = request.resource.data;
      let o = resource.data;
      let need = [3000, 4800, 7680, 12288, 19661, 31457, 50332, 80531, 128849];
      let d = dailyPath(a, uid());
      let before = exists(d) ? get(d).data.get('total', 0) : 0;
      return isMember(a)
        && n.diff(o).affectedKeys().hasOnly(['exp', 'level', 'memberMax', 'weekPoints', 'fund', 'updatedAt'])
        && n.updatedAt == request.time
        && n.memberMax == memberMaxFor(n.level)
        && n.weekPoints >= o.weekPoints && n.weekPoints - o.weekPoints <= 30
        && n.get('fund', 0) >= o.get('fund', 0) && n.get('fund', 0) - o.get('fund', 0) <= 300
        && ((n.level == o.level && n.exp >= o.exp && n.exp - o.exp <= 300)
            || (o.level < 10 && n.level == o.level + 1 && n.exp >= 0 && n.exp < 300 && o.exp + 300 >= need[o.level - 1]))
        && existsAfter(d)
        && getAfter(d).data.get('total', 0) == before + 1;
    }

    // 研究: 同盟長・副長が、同盟の資金で、1つの系統を1段進める。値段と必要な同盟Lvは、段で決まる (どの系統も同じ。
    // src/game/data/allianceResearch.ts の RESEARCH_STEPS と同じ数)。資金は、その値段だけ減る。
    function researchLevel(d, line) {
      return d.get('research', {}).get(line, 0);
    }
    function researchCost(step) {
      return [15000, 30000, 60000, 110000, 180000][step];
    }
    function researchNeedLevel(step) {
      return [2, 3, 5, 7, 9][step];
    }
    function researchSame(line) {
      return researchLevel(request.resource.data, line) == researchLevel(resource.data, line);
    }
    function researchStep(line) {
      let n = request.resource.data;
      let o = resource.data;
      let before = researchLevel(o, line);
      return before is int && before >= 0 && before < 5
        && researchLevel(n, line) == before + 1
        && o.level >= researchNeedLevel(before)
        && o.get('fund', 0) >= researchCost(before)
        && n.fund == o.get('fund', 0) - researchCost(before);
    }
    function isResearchUpdate(a) {
      let n = request.resource.data;
      return isOfficerUp(a)
        && n.diff(resource.data).affectedKeys().hasOnly(['fund', 'research', 'updatedAt'])
        && n.updatedAt == request.time
        && n.research is map && n.research.keys().hasOnly(['battle', 'income', 'growth'])
        && ((researchStep('battle') && researchSame('income') && researchSame('growth'))
            || (researchStep('income') && researchSame('battle') && researchSame('growth'))
            || (researchStep('growth') && researchSame('battle') && researchSame('income')));
    }

    match /alliances/{allianceId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && validNewAlliance(request.resource.data)
        && !exists(alliancePath(allianceId))
        && existsAfter(memberPath(allianceId, uid()))
        && getAfter(memberPath(allianceId, uid())).data.role == 'leader'
        && existsAfter(/databases/$(database)/documents/allianceNames/$(request.resource.data.nameLower));

      allow update: if signedIn()
        && (isLeaderSettingsUpdate(allianceId) || isMemberCountUpdate(allianceId) || isDonationUpdate(allianceId) || isResearchUpdate(allianceId));

      // 解散。ほかのメンバーの文書と、サブコレクションは、Cloud Functions (onAllianceDeleted) が消す。
      allow delete: if signedIn() && isLeader(allianceId);

      // ---------------------------------------------------------------- メンバー
      function validMemberFields(d) {
        return d.name is string && d.name.size() <= 24
          && d.level is number && d.level >= 1 && d.level <= 999
          && d.power is number && d.power >= 0
          && (d.helper == null || (d.helper is map
              && d.helper.heroId is string && d.helper.heroId.size() <= 40
              && d.helper.level is number && d.helper.power is number && d.helper.power >= 0
              && d.helper.skillLevels is list && d.helper.skillLevels.size() <= 4));
      }

      match /members/{memberAuth} {
        // 自分の文書は、(外されたあとでも) 読める (「ない」と分かるため)。一覧と、ほかの人の文書は、メンバーだけ。
        allow get: if signedIn() && (memberAuth == uid() || isMember(allianceId));
        allow list: if signedIn() && isMember(allianceId);

        // 同盟を作った人 (同じバッチで、同盟の文書もできる)。
        allow create: if signedIn() && memberAuth == uid()
          && !exists(alliancePath(allianceId))
          && existsAfter(alliancePath(allianceId))
          && request.resource.data.role == 'leader'
          && request.resource.data.keys().hasOnly(['playerId', 'name', 'level', 'power', 'role', 'contribution', 'weekContribution', 'weekId', 'coins', 'lastActiveAt', 'joinedAt', 'helper'])
          && validMemberFields(request.resource.data)
          && request.resource.data.playerId == get(userPath(uid())).data.playerId
          && request.resource.data.contribution == 0 && request.resource.data.coins == 0
          && request.resource.data.joinedAt == request.time && request.resource.data.lastActiveAt == request.time;

        // 入る。いまの人数が上限未満で、24時間の待ちが済み、どこにも入っていなくて、(自由参加で条件を満たす / 承認された / 招待された)。
        allow create: if signedIn() && memberAuth == uid()
          && exists(alliancePath(allianceId))
          && request.resource.data.role == 'member'
          && request.resource.data.keys().hasOnly(['playerId', 'name', 'level', 'power', 'role', 'contribution', 'weekContribution', 'weekId', 'coins', 'lastActiveAt', 'joinedAt', 'helper'])
          && validMemberFields(request.resource.data)
          && request.resource.data.playerId == get(userPath(uid())).data.playerId
          && request.resource.data.contribution == 0 && request.resource.data.coins == 0
          && request.resource.data.joinedAt == request.time && request.resource.data.lastActiveAt == request.time
          && get(alliancePath(allianceId)).data.memberCount < get(alliancePath(allianceId)).data.memberMax
          && (get(userPath(uid())).data.get('leftAt', null) == null
              || get(userPath(uid())).data.leftAt + duration.value(24, 'h') < request.time)
          && (get(userPath(uid())).data.get('allianceId', null) == null)
          && ((get(alliancePath(allianceId)).data.joinPolicy == 'open'
                && request.resource.data.level >= get(alliancePath(allianceId)).data.minPlayerLevel)
              || (exists(/databases/$(database)/documents/alliances/$(allianceId)/requests/$(uid()))
                  && get(/databases/$(database)/documents/alliances/$(allianceId)/requests/$(uid())).data.status == 'approved')
              || exists(/databases/$(database)/documents/users/$(uid())/invites/$(allianceId)));

        // 自分の情報 (名前・Lv・総合力・助っ人・最終ログイン・貢献・コイン)。1回の書き込みで増えるのは、上限つき。役職は、ここでは変えられない。
        allow update: if signedIn() && memberAuth == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'level', 'power', 'helper', 'lastActiveAt', 'contribution', 'weekContribution', 'weekId', 'coins'])
          && validMemberFields(request.resource.data)
          && request.resource.data.contribution >= resource.data.contribution
          && request.resource.data.contribution - resource.data.contribution <= 30
          && request.resource.data.coins - resource.data.coins <= 100;

        // 役職の変更 (同盟長だけ)。
        allow update: if signedIn() && isLeader(allianceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['leader', 'officer', 'member'];

        // 抜ける (自分)。同盟長は、ほかに人がいなければ (解散)。外す (幹部以上): 幹部は、メンバーだけ。
        allow delete: if signedIn()
          && ((memberAuth == uid()
                && (resource.data.role != 'leader' || get(alliancePath(allianceId)).data.memberCount == 1))
              || (isLeader(allianceId) && memberAuth != uid())
              || (isOfficerUp(allianceId) && resource.data.role == 'member'));

        // 1日ごとの回数 (寄付・ステージ・返事・スタミナ)。ドキュメントIDが「今日」のものだけ。
        // raidAttempts (ボスへの挑戦回数) は、サーバーだけが数える (クライアントが作るときは 0、更新では変えられない)。
        match /daily/{dayId} {
          allow read: if signedIn() && memberAuth == uid();
          allow create, update: if signedIn() && memberAuth == uid() && isMember(allianceId)
            && dayId == dayKey()
            && request.resource.data.keys().hasOnly(['donGold', 'donMaterials', 'donGems', 'total', 'stages', 'answers', 'staminaSent', 'staminaReceived', 'lendCoinsClaimed', 'raidAttempts', 'updatedAt'])
            && request.resource.data.get('donGold', 0) <= 5
            && request.resource.data.get('donMaterials', 0) <= 5
            && request.resource.data.get('donGems', 0) <= 3
            && request.resource.data.get('total', 0) == request.resource.data.get('donGold', 0) + request.resource.data.get('donMaterials', 0) + request.resource.data.get('donGems', 0)
            && request.resource.data.get('stages', 0) <= 200
            && request.resource.data.get('answers', 0) <= 5
            && request.resource.data.get('staminaSent', 0) <= 5
            && request.resource.data.get('staminaReceived', 0) <= 10
            && request.resource.data.get('lendCoinsClaimed', 0) <= 15
            && request.resource.data.updatedAt == request.time
            && (request.method == 'create'
                ? request.resource.data.get('raidAttempts', 0) == 0
                : (request.resource.data.get('raidAttempts', 0) == resource.data.get('raidAttempts', 0)
                   && request.resource.data.get('donGold', 0) >= resource.data.get('donGold', 0)
                   && request.resource.data.get('donMaterials', 0) >= resource.data.get('donMaterials', 0)
                   && request.resource.data.get('donGems', 0) >= resource.data.get('donGems', 0)
                   && request.resource.data.get('stages', 0) >= resource.data.get('stages', 0)
                   && request.resource.data.get('answers', 0) >= resource.data.get('answers', 0)
                   && request.resource.data.get('staminaSent', 0) >= resource.data.get('staminaSent', 0)
                   && request.resource.data.get('staminaReceived', 0) >= resource.data.get('staminaReceived', 0)
                   && request.resource.data.get('lendCoinsClaimed', 0) >= resource.data.get('lendCoinsClaimed', 0)));
          allow delete: if false;
        }

        // 受け取り箱: 同盟のメンバーが入れる (スタミナの支援・助っ人を貸したお礼)。持ち主だけが読んで、消せる。
        match /inbox/{itemId} {
          allow read, delete: if signedIn() && memberAuth == uid();
          allow create: if signedIn() && isMember(allianceId)
            && request.resource.data.keys().hasOnly(['kind', 'amount', 'fromAuth', 'fromName', 'at'])
            && request.resource.data.fromAuth == uid()
            && request.resource.data.at == request.time
            && ((request.resource.data.kind == 'stamina' && request.resource.data.amount == 10)
                || (request.resource.data.kind == 'lend' && request.resource.data.amount == 5));
          allow update: if false;
        }
      }

      // ---------------------------------------------------------------- 参加申請 (承認制)
      match /requests/{requestAuth} {
        allow read: if signedIn() && (requestAuth == uid() || isOfficerUp(allianceId));
        allow create: if signedIn() && requestAuth == uid()
          && !isMember(allianceId)
          && get(alliancePath(allianceId)).data.joinPolicy == 'approval'
          && request.resource.data.keys().hasOnly(['playerId', 'name', 'level', 'power', 'at', 'status'])
          && request.resource.data.status == 'pending'
          && request.resource.data.at == request.time
          && request.resource.data.level >= get(alliancePath(allianceId)).data.minPlayerLevel
          && request.resource.data.playerId == get(userPath(uid())).data.playerId;
        // 承認 (幹部以上): 申請した本人が、次に開いたときに、自分で入る。
        allow update: if signedIn() && isOfficerUp(allianceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'approved';
        allow delete: if signedIn() && (requestAuth == uid() || isOfficerUp(allianceId));
      }

      // ---------------------------------------------------------------- 共闘ボス (書くのは Cloud Functions だけ)
      match /raid/{raidWeek} {
        allow read: if signedIn() && isMember(allianceId);
        allow write: if false;

        match /damage/{damageAuth} {
          allow read: if signedIn() && isMember(allianceId);
          allow write: if false;
        }
        match /hits/{hitId} {
          allow read, write: if false;
        }
        // 報酬の受け取り: 1人1回 (ドキュメントIDが自分)。ダメージを与えていて、撃破済み、または、週が終わっているときだけ。
        match /claims/{claimAuth} {
          allow read: if signedIn() && claimAuth == uid();
          allow create: if signedIn() && claimAuth == uid() && isMember(allianceId)
            && request.resource.data.keys().hasOnly(['at', 'rank'])
            && request.resource.data.at == request.time
            && exists(/databases/$(database)/documents/alliances/$(allianceId)/raid/$(raidWeek)/damage/$(uid()))
            && (get(/databases/$(database)/documents/alliances/$(allianceId)/raid/$(raidWeek)).data.defeatedAt != null
                || get(/databases/$(database)/documents/alliances/$(allianceId)/raid/$(raidWeek)).data.endsAt < request.time);
          allow update, delete: if false;
        }
      }

      // 切符: サーバーだけ。
      match /tickets/{ticketId} {
        allow read, write: if false;
      }

      // ---------------------------------------------------------------- 同盟ミッション (1日 / 1週間ごとの掲示板)
      // missionTotals/{d2026-11-24 | w2026-11-23}: その期間の目標 (goals: 期間の初めに、最初に足した人が決める。そのあとは変えられない)、
      // 同盟の合計 (progress)、メンバーごとの貢献 (by)、メンバーごとの受け取り済み (claims)。文書IDは、いまの期間のものだけ。
      // 足せるのは、自分の貢献だけ (by.{自分}) で、合計は、自分の貢献が増えた分と同じだけ増える。1人が1期間に足せる数には、上限がある
      // (行動ごと。1日の上限 × 週は7倍: src/game/data/allianceMissions.ts の MISSION_DAILY_CAP と同じ数)。
      // 受け取りは、1人が1つずつ。合計が目標に届いていて、自分の貢献が1以上のときだけ。
      function missionBoardId(kind) {
        return kind == 'daily' ? 'd' + dayKey() : 'w' + weekKey();
      }
      // 1つの行動について: 自分の貢献は、減らず、上限 (cap) を超えず、合計は、自分の貢献が増えた分だけ増える。
      // (a, b = 自分の貢献の、あと / まえ。p, q = 合計の、あと / まえ。ルールには、式の数に上限 (1リクエストで1000) があるので、短く書いてある。)
      function missionStep(a, b, p, q, k, cap) {
        return a.get(k, 0) >= b.get(k, 0) && a.get(k, 0) <= cap
          && p.get(k, 0) - q.get(k, 0) == a.get(k, 0) - b.get(k, 0);
      }
      // 行動は8つ (src/game/alliance/AllianceBackend.ts の MISSION_METRICS)。上限は、1日の分に、週なら7を掛ける
      // (src/game/data/allianceMissions.ts の MISSION_DAILY_CAP と同じ数)。
      function missionStepsOk(a, b, p, q, m) {
        return a.keys().hasOnly(['stage', 'gacha', 'donate', 'raid', 'stamina', 'idle', 'enhance', 'helper'])
          && p.keys().hasOnly(['stage', 'gacha', 'donate', 'raid', 'stamina', 'idle', 'enhance', 'helper'])
          && missionStep(a, b, p, q, 'stage', 300 * m) && missionStep(a, b, p, q, 'gacha', 300 * m)
          && missionStep(a, b, p, q, 'donate', 13 * m) && missionStep(a, b, p, q, 'raid', 5 * m)
          && missionStep(a, b, p, q, 'stamina', 1000 * m) && missionStep(a, b, p, q, 'idle', 10 * m)
          && missionStep(a, b, p, q, 'enhance', 200 * m) && missionStep(a, b, p, q, 'helper', 20 * m);
      }
      function missionGoalOk(goals, i) {
        return goals.size() <= i
          || (goals[i] is map && goals[i].keys().hasOnly(['id', 'metric', 'target'])
              && goals[i].id is string && goals[i].id.size() >= 1 && goals[i].id.size() <= 20
              && goals[i].metric in ['stage', 'gacha', 'donate', 'raid', 'stamina', 'idle', 'enhance', 'helper']
              && goals[i].target is number && goals[i].target >= 1 && goals[i].target <= 10000000);
      }
      function validNewMissionBoard(boardId, d) {
        return d.keys().hasOnly(['kind', 'members', 'goals', 'progress', 'by', 'claims', 'updatedAt'])
          && d.kind in ['daily', 'weekly']
          && boardId == missionBoardId(d.kind)
          && d.members is int && d.members == get(alliancePath(allianceId)).data.memberCount
          && d.goals is list && d.goals.size() >= 1 && d.goals.size() <= (d.kind == 'daily' ? 3 : 1)
          && missionGoalOk(d.goals, 0) && missionGoalOk(d.goals, 1) && missionGoalOk(d.goals, 2)
          && d.by is map && d.by.keys().hasOnly([uid()])
          && d.progress is map
          && missionStepsOk(d.by.get(uid(), {}), {}, d.progress, {}, d.kind == 'weekly' ? 7 : 1)
          && d.claims == {}
          && d.updatedAt == request.time;
      }
      function isMissionReport() {
        let n = request.resource.data;
        let o = resource.data;
        return n.diff(o).affectedKeys().hasOnly(['progress', 'by', 'updatedAt'])
          && n.updatedAt == request.time
          && n.by.diff(o.by).affectedKeys().hasOnly([uid()])
          && missionStepsOk(n.by[uid()], o.by.get(uid(), {}), n.progress, o.progress, o.kind == 'weekly' ? 7 : 1);
      }
      function missionGoalMet(d, id, i) {
        return d.goals.size() > i && d.goals[i].id == id
          && d.progress.get(d.goals[i].metric, 0) >= d.goals[i].target
          && d.by.get(uid(), {}).get(d.goals[i].metric, 0) >= 1;
      }
      function isMissionClaim() {
        let n = request.resource.data;
        let o = resource.data;
        let after = n.claims.get(uid(), []);
        let before = o.claims.get(uid(), []);
        return n.diff(o).affectedKeys().hasOnly(['claims', 'updatedAt'])
          && n.updatedAt == request.time
          && n.claims.diff(o.claims).affectedKeys().hasOnly([uid()])
          && after.size() == before.size() + 1
          && after.hasAll(before)
          && !(after[before.size()] in before)
          && (missionGoalMet(o, after[before.size()], 0) || missionGoalMet(o, after[before.size()], 1) || missionGoalMet(o, after[before.size()], 2));
      }

      match /missionTotals/{boardId} {
        allow read: if signedIn() && isMember(allianceId);
        allow create: if signedIn() && isMember(allianceId) && validNewMissionBoard(boardId, request.resource.data);
        allow update: if signedIn() && isMember(allianceId)
          && boardId == missionBoardId(resource.data.kind)
          && (isMissionReport() || isMissionClaim());
        allow delete: if false;
      }

      // 助っ人を貸した回数 (貸した人 × 今日)。ID は「{貸した人}_{今日}」。1日に、お礼の対象になるのは3回まで。
      match /lends/{lendId} {
        allow read: if signedIn() && isMember(allianceId);
        allow create: if signedIn() && isMember(allianceId)
          && lendId.split('_')[1] == dayKey()
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n == 1;
        allow update: if signedIn() && isMember(allianceId)
          && lendId.split('_')[1] == dayKey()
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n == resource.data.n + 1
          && request.resource.data.n <= 3;
        allow delete: if false;
      }

      // ---------------------------------------------------------------- チャット
      // text と help は、メンバーが書く。system (加入・脱退・撃破など) は、Cloud Functions だけが書く。
      match /chat/{messageId} {
        allow read: if signedIn() && isMember(allianceId);
        allow create: if signedIn() && isMember(allianceId)
          && request.resource.data.keys().hasOnly(['kind', 'senderAuth', 'senderPlayerId', 'senderName', 'text', 'sentAt', 'help'])
          && request.resource.data.kind in ['text', 'help']
          && request.resource.data.senderAuth == uid()
          && request.resource.data.senderPlayerId == get(userPath(uid())).data.playerId
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 24
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 200
          && request.resource.data.sentAt == request.time
          && (request.resource.data.kind == 'text'
              ? !('help' in request.resource.data)
              : (request.resource.data.help.what in ['raid', 'village']
                 && request.resource.data.help.open == true
                 && request.resource.data.help.helpers.size() == 0));
        // 救援への返事: 助けた人の名前が、1人ふえる。
        allow update: if signedIn() && isMember(allianceId)
          && resource.data.kind == 'help'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['help'])
          && request.resource.data.help.what == resource.data.help.what
          && request.resource.data.help.helpers.size() == resource.data.help.helpers.size() + 1
          && request.resource.data.help.helpers.size() <= 30;
        allow delete: if false;
      }
    }

    // ====================================================================== 対抗戦 (シーズンは、週のID)

    match /seasons/{seasonId} {
      // リーグ表の1行 (同盟ごと)。作る・消す・ボスのポイントは Cloud Functions だけ。
      // メンバーが足せるのは、寄付・ステージ・助っ人のポイントだけ (1回の書き込みで、最大30)。
      match /entries/{entryAlliance} {
        allow read: if signedIn();
        allow create, delete: if false;
        allow update: if signedIn() && isMember(entryAlliance)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'donation', 'stages', 'helpers', 'updatedAt'])
          && request.resource.data.donation >= resource.data.donation
          && request.resource.data.stages >= resource.data.stages
          && request.resource.data.helpers >= resource.data.helpers
          && request.resource.data.donation - resource.data.donation <= 30
          && request.resource.data.stages - resource.data.stages <= 20
          && request.resource.data.helpers - resource.data.helpers <= 5
          && request.resource.data.points - resource.data.points
              == (request.resource.data.donation - resource.data.donation)
               + (request.resource.data.stages - resource.data.stages)
               + (request.resource.data.helpers - resource.data.helpers)
          && request.resource.data.updatedAt == request.time;
      }

      // 前のシーズンの結果 (順位・昇降格)。サーバーが書く。
      match /results/{resultAlliance} {
        allow read: if signedIn();
        allow write: if false;
      }

      // 結果の報酬の受け取り: 1人1回 (ID は「{同盟ID}_{認証uid}」)。
      match /claims/{claimId} {
        allow read: if signedIn() && claimId.split('_')[1] == uid();
        allow create: if signedIn()
          && claimId.split('_')[1] == uid()
          && isMember(claimId.split('_')[0])
          && exists(/databases/$(database)/documents/seasons/$(seasonId)/results/$(claimId.split('_')[0]))
          && request.resource.data.keys().hasOnly(['at', 'rank'])
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}

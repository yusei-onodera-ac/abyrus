# Big binary assets live in Git LFS (the repository itself keeps only small pointer files for them).
# Clone with git-lfs installed (git lfs install, once per machine) or the pictures come as pointer text files.
public/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
public/assets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
public/assets/audio/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
functions/certs/*.cer -text

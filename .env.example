# Firebase Web SDK config for Infinite Mode's global leaderboard (Event tab).
#
# Copy this file to `.env` and fill in the values from your own Firebase
# project - see BACKEND_SETUP.md for exactly how to create one and where to
# find each value (it's free, and takes about 10 minutes).
#
# Leaving these blank, or leaving `.env` missing entirely, is completely
# fine: the game still builds and runs, the Event tab shows "ランキング準備中"
# instead of a global leaderboard, and this device's own best score is kept
# locally.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 同盟 (アライアンス) の Cloud Functions を置いた地域。空でよい (既定: asia-northeast1 = 東京)。
# 同盟をサーバーで動かすには、上の VITE_FIREBASE_* に加えて、docs/ALLIANCE_SERVER.md の手順で、
# Firestore のルール・索引と functions/ をデプロイする。設定しなければ、疑似メンバーのローカル版で動く。
VITE_FIREBASE_FUNCTIONS_REGION=
